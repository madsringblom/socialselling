ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
FETCH_THREAD_CONTEXT=true
MAX_SCORED_PER_DAY=400
DRAFT_MODEL=claude-opus-5-5
RESEARCH_MODEL=claude-opus-5-5
MAX_DRAFTS_PER_DAY=5
DRAFT_MIN_CONFIDENCE=0.6
MAX_RESEARCH_PER_DAY=3
DRAFT_EXPIRY_H=24
UI_PORT=8787
# DB_PATH=data/social.db

# Research turn effort: medium (default, ~$1.4 per lead on Opus 5.5) or high (more thorough, ~2x cost)
RESEARCH_EFFORT=medium

# Facebook/LinkedIn group notifications read from Gmail (README "Facebook & LinkedIn via Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# unset = http://127.0.0.1:${UI_PORT}/api/gmail/callback; must match the Google Cloud client exactly
# GOOGLE_REDIRECT_URI=
MAIL_LABEL=Signals
MAIL_MAX_PER_RUN=50
# GMAIL_TOKEN_PATH=data/gmail-token.json
